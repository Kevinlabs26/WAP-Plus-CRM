# Normalize text files to LF in the repo; keep CRLF on Windows checkout.
# Fixes the CRLF/LF warnings and keeps diffs clean across platforms.
* text=auto eol=lf

# Explicit text types
*.ts        text eol=lf
*.tsx       text eol=lf
*.mjs       text eol=lf
*.js        text eol=lf
*.json      text eol=lf
*.rs        text eol=lf
*.kt        text eol=lf
*.gradle    text eol=lf
*.md        text eol=lf html
*.yml       text eol=lf
*.yaml      text eol=lf
*.toml      text eol=lf
*.py        text eol=lf
*.sh        text eol=lf
*.xml       text eol=lf
*.css       text eol=lf
*.html      text eol=lf

# Binary files (never touch)
*.png   binary
*.jpg   binary
*.jpeg  binary
*.gif   binary
*.ico   binary
*.webp  binary
*.pdf   binary
*.zip   binary
*.exe   binary
*.jar   binary
*.apk   binary
*.aab   binary
*.woff  binary
*.woff2 binary
*.ttf   binary
*.otf   binary