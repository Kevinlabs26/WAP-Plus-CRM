{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "WAP Plus CRM",
  "version": "0.1.23",
  "identifier": "com.wapplus.crm",
  "build": {
    "beforeDevCommand": "npm run dev",
    "devUrl": "http://localhost:3000",
    "beforeBuildCommand": "npm run build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "title": "WAP Plus CRM",
        "width": 1440,
        "height": 900,
        "minWidth": 1280,
        "minHeight": 760,
        "resizable": true
      }
    ],
    "security": {
      "csp": "default-src 'self'; script-src 'self' 'wasm-unsafe-eval'; connect-src 'self' ipc: http://ipc.localhost https: http://127.0.0.1:* ws://127.0.0.1:*; img-src 'self' data: blob: https:; media-src 'self' data: blob:; style-src 'self' 'unsafe-inline'; font-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "createUpdaterArtifacts": true,
    "externalBin": ["binaries/wap-plus-baileys"],
    "icon": ["icons/32x32.png", "icons/icon.ico"],
    "windows": {
      "nsis": {
        "installerHooks": "windows/installer-hooks.nsh"
      }
    }
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IENDNjVCMjlCMkZGQTg3RkQKUldUOWgvb3ZtN0psekZvNXo4bGxlVHBWYnFJTFNEcTVPdk1GNzJLaWZJSGFaaUU4RnI3ZmsyVGYK",
      "endpoints": [
        "https://github.com/Kevinlabs26/WAP-Plus-CRM/releases/latest/download/latest.json"
      ],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
